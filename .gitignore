# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
/.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.coverage
coverage.xml

# Build/package artifacts
build/
dist/
*.egg-info/

# Sphinx HTML output — regenerate with `uv run --group docs poe docs`
docs/_build/

# Local environment/config
.env
.env.*
.python-version

# IDE/editor settings
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Excel generated temp files
~$*.xlsx
*.tmp


# Test-model workbook — one sheet per test model, built by
# build_test_models.py. A QC fixture, not a shipped artifact: it is
# regenerated from the case registries on demand and would otherwise add a
# multi-megabyte binary to every commit that touches a spec case.
Lambda_Library_TestModels.xlsx

# Detached-build log/pid artifacts at the repo root (local dev only)
# Anchored with `/` so this does not collide with the per-run transcripts
# in excel-only-runs/, whose filenames also begin `build_` by convention.
/build_*.log
/build_*.err
/build_*.pid

# logs/ holds the rerouted outputs of detached build_*.py runs. Always local dev only.
/logs/

# Force-include the shipped workbook (build output that lives in dist/)
!dist/Lambda_Library.xlsx

# Manual updates folder
Manual Updates/


# Claude local/project assistant files
.claude/
.claude.json
CLAUDE.local.md
